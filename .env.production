# Used automatically by `vite build` (production mode) only - local `npm run dev`
# still uses the plain .env (http://localhost:8080/api/v1). A relative path here
# means the built SPA calls the API on whatever domain/IP it's actually served
# from, with nginx reverse-proxying /api to the backend - no rebuild needed if
# the deployment's public IP/domain ever changes.
VITE_API_BASE_URL=/api/v1
